# Base de datos
DATABASE_URL=postgresql+asyncpg://usuario:contraseña@localhost:5432/api_usuario_roles_db


# Estado de la aplicacion solo en local
DEBUG=True


# Seguridad JWT — cambiar en produccion
JWT_SECRET_KEY=mi_secreto_super_secreto_cambiar_en_produccion
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=15


# Cache de estado del usuario autenticado (patrón híbrido: JWT corto + TTL cache)
AUTH_CACHE_TTL_SEGUNDOS=60
AUTH_CACHE_MAX_ITEMS=1000


# CORS — origenes permitidos (frontend)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]