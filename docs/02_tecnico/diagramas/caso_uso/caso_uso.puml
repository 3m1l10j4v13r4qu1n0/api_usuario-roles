@startuml Diagrama de Casos de Uso
!pragma layout smetana
title Casos de Uso - API de Usuarios y Roles

actor "Usuario No Autenticado" as UNAUTH
actor "Usuario Autenticado" as AUTH
actor "Administrador (ADMIN)" as ADMIN
actor "Sistema Consumidor" as SYS

rectangle "Autenticacion" {
  usecase "UC1 - Login (emitir JWT)" as UC1
  usecase "Obtener usuario autenticado (/auth/me)" as MEAUTH
}

rectangle "Gestion de Usuarios" {
  usecase "UC2 - Registrar usuario" as UC2
  usecase "UC3 - Listar usuarios" as UC3
  usecase "UC4 - Obtener usuario por ID" as UC4
  usecase "UC5 - Actualizar usuario" as UC5
  usecase "UC6 - Baja logica" as UC6
}

rectangle "Gestion de Roles" {
  usecase "UC7 - Crear rol" as UC7
  usecase "UC8 - Listar roles" as UC8
  usecase "UC9 - Asignar rol" as UC9
  usecase "UC10 - Quitar rol" as UC10
}

UNAUTH --> UC1
UNAUTH --> UC2
AUTH --> MEAUTH
AUTH --> UC4
AUTH --> UC5
ADMIN --> UC3
ADMIN --> UC4
ADMIN --> UC5
ADMIN --> UC6
ADMIN --> UC7
ADMIN --> UC8
ADMIN --> UC9
ADMIN --> UC10
SYS --> UC1
SYS --> MEAUTH

note right of UC2
  Registro publico: autoasigna rol USUARIO
end note

note right of UC9
  Al asignar/quitar rol o dar de baja
  se invalida el cache -> revocacion en caliente
end note

@enduml